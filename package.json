{
  "name": "retrodesk-portfolio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "start:client": "npm --workspace client run start",
    "start:server": "npm --workspace server run start",
    "add": "npm --workspace client run add"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
