{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen": "node scripts/gen-tracks.mjs && node scripts/gen-sfx.mjs && node scripts/gen-gallery.mjs && node scripts/gen-projects.mjs && node scripts/gen-games.mjs && node scripts/gen-library.mjs && node ../blog/scripts/build.mjs --manifest && node scripts/copy-pdf-worker.mjs",
    "predev": "npm run gen",
    "dev": "concurrently -k -n lib,music,next -c gray,gray,cyan \"npm:library:watch\" \"npm:music:watch\" \"next dev -p 3000\"",
    "prebuild": "npm run gen",
    "build": "next build",
    "start": "next start -p 3000",
    "tracks": "node scripts/gen-tracks.mjs",
    "sfx": "node scripts/gen-sfx.mjs",
    "music:watch": "node scripts/gen-tracks.mjs --watch",
    "gallery": "node scripts/gen-gallery.mjs",
    "projects": "node scripts/gen-projects.mjs",
    "games": "node scripts/gen-games.mjs",
    "library": "node scripts/gen-library.mjs",
    "library:watch": "node scripts/gen-library.mjs --watch",
    "blog": "node ../blog/scripts/build.mjs --manifest",
    "add": "node scripts/add-project.mjs",
    "add:doc": "node scripts/add-doc.mjs",
    "lint": "next lint",
    "lint:icons": "node scripts/lint-icons.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "music-metadata": "^11.13.0",
    "next": "^16.2.6",
    "pdfjs-dist": "^4.10.38",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.4.13",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
