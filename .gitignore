# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
out/
dist/
build/
# ...except the Unity WebGL player output, which is a shipped asset, not a
# local build artefact. Without this the game 404s on a fresh clone.
!client/public/games/*/Build/

# TypeScript incremental build cache — regenerated by tsc on every build.
*.tsbuildinfo

# pdf.js worker — copied out of node_modules by scripts/copy-pdf-worker.mjs on
# every `npm run gen` (predev/prebuild), so it never needs to be tracked.
client/public/vendor/

# Env
.env
.env.local
.env*.local
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
